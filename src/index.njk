---
title: Portfolio
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Game Design Portfolio</title>
</head>
<body>
  <h1>Мои проекты</h1>

  <main>
    {% for project in collections.projects %}
      <article>
        <h2>{{ project.data.title }}</h2>
        <p>{{ project.data.period }}</p>
        <p>{{ project.data.description }}</p>

        <h3>Роли</h3>
        <ul>
          {% for role in project.data.roles %}
            <li>{{ role }}</li>
          {% endfor %}
        </ul>

        <div>
          {{ project.templateContent | safe }}
        </div>
      </article>
      <hr>
    {% endfor %}
  </main>
</body>
</html>

---
title: Portfolio
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Game Design Portfolio</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <script src="{{ '/js/gallery.js' | url }}" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <h1>Game Design Portfolio</h1>
    </div>
  </header>

  <main class="container">
<nav class="gallery-filters" aria-label="Фильтр проектов">
  <button class="filter-button is-active" type="button" data-filter="all" aria-pressed="true">Все</button>
  <button class="filter-button" type="button" data-filter="GD" aria-pressed="false">GD</button>
  <button class="filter-button" type="button" data-filter="LD" aria-pressed="false">LD</button>
  <button class="filter-button" type="button" data-filter="ND" aria-pressed="false">ND</button>
  <button class="filter-button" type="button" data-filter="PM" aria-pressed="false">PM</button>
</nav>
    <section class="gallery" aria-label="Проекты">
      {% for project in collections.projects %}
        <article class="project-card">
          <button
            class="project-cover"
          type="button"
         aria-expanded="false"
        aria-controls="project-details"
        >
           {% if project.data.cover %}
             <img
             class="project-cover-image"
             src="{{ project.data.cover | url }}"
             alt=""
             loading="lazy"
             decoding="async"
             >
           {% else %}
         <span>{{ project.data.title }}</span>
         {% endif %}
        </button>


          <h2 class="project-title">
            {{ project.data.title }}
          </h2>

          <p class="project-meta">
            {{ project.data.period }}
          </p>

          <div class="project-tags">
            {% for role in project.data.roles %}
              <span class="project-tag">{{ role }}</span>
            {% endfor %}
          </div>

          
<template class="project-template">
  <header class="case-header">
    <div class="case-header-main">
      <h2 class="case-title">{{ project.data.title }}</h2>
      <p class="case-period">{{ project.data.period }}</p>
      <p class="case-description">
        {{ project.data.description }}
      </p>
    </div>

    <div class="case-roles" aria-label="Роли в проекте">
      {% for role in project.data.roles %}
        <span class="project-tag">{{ role }}</span>
      {% endfor %}
    </div>
  </header>

{% if project.data.artifacts and project.data.artifacts.length %}
<section class="case-artifacts" aria-label="Материалы проекта">
  <h3 class="case-artifacts-title">Ключевые материалы</h3>

  <ul class="case-artifacts-list">
    {% for artifact in project.data.artifacts %}
      <li>
        <a class="case-artifact" href="{{ artifact.url }}">
          <span class="case-artifact-name">{{ artifact.title }}</span>
          <span class="case-artifact-type">{{ artifact.type }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

  <div class="case-content">
    {{ project.templateContent | safe }}
  </div>
</template>

        </article>
      {% endfor %}
    </section>
  </main>
</body>
</html>
